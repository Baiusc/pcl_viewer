{
  "model": "CS96-beta",
  "interface": "eth0",
  "state_path": "/run/lidar-data/lidar/config/network.json",
  "runtime_dir": "/run/lidar-network",
  "socket_path": "/run/lidar-network/control.sock",
  "sn_path": "/dev/mtd3",
  "legacy_interfaces": "/etc/network/interfaces",
