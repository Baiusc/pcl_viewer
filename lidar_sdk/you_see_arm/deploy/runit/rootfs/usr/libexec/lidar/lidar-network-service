#!/bin/sh
# 网络与采集使用同一监督树、不同服务目录；不在 rcS 内等待 runsvdir。
set -eu
umask 077
. "${LIDAR_SERVICE_CONFIG:-/etc/lidar/service.conf}"
[ "${LIDAR_NETWORK_ENABLED:-0}" = 1 ] || exit 0
SERVICE=$LIDAR_SCAN/lidar_netd
NET_RUN=${LIDAR_NETWORK_RUN:-/run/lidar-network}
NET_EXEC=${LIDAR_NETWORK_EXEC:-/usr/libexec/lidar/lidar_netd}
NET_CTL=${LIDAR_NETWORK_CTL:-/usr/libexec/lidar/lidar_netctl}
NET_CONFIG=${LIDAR_NETWORK_CONFIG:-/etc/lidar/network.json}
NET_SOCKET=${LIDAR_NETWORK_SOCKET:-/run/lidar-network/control.sock}
NET_TEMPLATE=${LIDAR_NETWORK_TEMPLATE:-/usr/share/lidar/runit/lidar_netd}
case "${1:-}" in
enable)
    for path in "$NET_RUN" "$LIDAR_SCAN"; do
        [ ! -L "$path" ] || { echo '网络服务目录不能是符号链接' >&2; exit 1; }
        mkdir -p "$path"
        chmod 700 "$path"
    done
    if [ "${LIDAR_STORAGE_MODE:-managed}" != boot-copy ]; then
        for path in "$LIDAR_STORAGE_MOUNT/lidar" "$LIDAR_STORAGE_MOUNT/lidar/config"; do
            [ ! -L "$path" ] || { echo '持久配置目录不能是符号链接' >&2; exit 1; }
            if ! mkdir -p "$path" || ! chmod 700 "$path"; then
                echo '持久存储不可用，继续启动临时网络诊断服务' >&2
                break
            fi
        done
    fi
    for tool in "$NET_EXEC" "$NET_CTL" "$LIDAR_SV"; do
        [ -x "$tool" ] || { echo "缺少网络服务工具：$tool" >&2; exit 1; }
    done
    if [ ! -d "$SERVICE" ]; then
        mkdir "$SERVICE" "$SERVICE/log"
        cp "$NET_TEMPLATE/run" "$NET_TEMPLATE/check" "$NET_TEMPLATE/finish" "$SERVICE/"
        cp "$NET_TEMPLATE/log/run" "$SERVICE/log/run"
        chmod 700 "$SERVICE/run" "$SERVICE/check" "$SERVICE/finish" "$SERVICE/log/run"
    fi
    rm -f "$SERVICE/down" "$NET_RUN/failures"
    if "$LIDAR_SV" status "$SERVICE" >/dev/null 2>&1; then "$LIDAR_SV" up "$SERVICE"; fi
    ;;
run)
    if [ "${LIDAR_STORAGE_MODE:-managed}" = boot-copy ]; then
        export LIDAR_PERSIST_COMMAND="$LIDAR_STORAGE_EXEC"
    fi
    read -r started rest < /proc/uptime
    printf '%s\n' "${started%%.*}" > "$NET_RUN/started-at"
    exec "$NET_EXEC" "$NET_CONFIG"
    ;;
check)
    # 无网线或配置故障仍保留查询能力；不能让监督器反复重启诊断服务。
    exec "$NET_CTL" "$NET_SOCKET" get
    ;;
stop)
    [ -d "$SERVICE" ] || exit 0
    : > "$SERVICE/down"
    "$LIDAR_SV" -w "$LIDAR_STOP_SECONDS" stop "$SERVICE"
    ;;
restart)
    [ -d "$SERVICE" ] || { echo '网络服务尚未登记，无法重启' >&2; exit 1; }
    rm -f "$SERVICE/down" "$NET_RUN/failures"
    "$LIDAR_SV" -w "$LIDAR_STOP_SECONDS" restart "$SERVICE"
    ;;
finish)
    [ ! -f "$SERVICE/down" ] || exit 0
    failures=0
    [ ! -f "$NET_RUN/failures" ] || read -r failures < "$NET_RUN/failures"
    case "$failures" in ''|*[!0-9]*) failures=3 ;; esac
    started=0
    [ ! -f "$NET_RUN/started-at" ] || read -r started < "$NET_RUN/started-at"
    case "$started" in ''|*[!0-9]*) started=0 ;; esac
    read -r seconds rest < /proc/uptime
    if [ "$((${seconds%%.*} - started))" -ge 60 ]; then failures=0; fi
    failures=$((failures + 1))
    printf '%s\n' "$failures" > "$NET_RUN/failures"
    if [ "$failures" -ge 3 ]; then
        : > "$SERVICE/down"
        "$LIDAR_SV" down "$SERVICE"
        echo '网络服务连续启动失败，已停止自动重试，请检查配置和系统组件' >&2
    else
        sleep 2
    fi
    ;;
*) echo '用法：lidar-network-service enable|run|check|stop|restart|finish' >&2; exit 2 ;;
esac
