# 机型、模式和算法的唯一关系表；在编译器探测前完成配置校验。
file(READ "${CMAKE_CURRENT_LIST_DIR}/../configs/build_catalog.json" YS_CATALOG)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/../configs/build_catalog.json")
set(MODEL "" CACHE STRING "机型")
set(DATA_MODE "" CACHE STRING "数据模式：histogram、pointcloud、gray")
option(LOCAL_TEST "使用主机工具链" OFF)
string(JSON YS_MODEL ERROR_VARIABLE _error GET "${YS_CATALOG}" models "${MODEL}")
if(_error)
    message(FATAL_ERROR "必须指定有效 MODEL；使用 python3 scripts/build.py list 查看预设")
endif()
string(JSON YS_RUNTIME_MODES ERROR_VARIABLE _runtime_error GET "${YS_MODEL}" runtime_modes)
if(_runtime_error)
    set(YS_RUNTIME_MODES OFF)
endif()
set(default_reflectivity OFF)
set(default_spotslope OFF)
if(YS_RUNTIME_MODES)
    if(DATA_MODE AND NOT DATA_MODE STREQUAL "runtime")
        message(FATAL_ERROR "${MODEL} 已按机型收敛，请移除 DATA_MODE；在运行配置中选择模式")
    endif()
    set(DATA_MODE "runtime")
    set(DRIVER_RCV_MODE "runtime")
    set(default_reflectivity ON)
    if(MODEL STREQUAL "CS96-beta")
        set(default_spotslope ON)
    endif()
else()
    string(JSON DRIVER_RCV_MODE ERROR_VARIABLE _error GET "${YS_MODEL}" modes "${DATA_MODE}")
    if(_error)
        message(FATAL_ERROR "${MODEL} 不支持 DATA_MODE=${DATA_MODE}，必须显式选择数据模式")
    endif()
endif()
option(YS_REFLECTIVITY "编入 CS96 反射率标定库" ${default_reflectivity})
option(YS_SPOT_SLOPE "编入 Beta 按面水平角修正" ${default_spotslope})
if(YS_RUNTIME_MODES AND (NOT YS_REFLECTIVITY OR (MODEL STREQUAL "CS96-beta" AND NOT YS_SPOT_SLOPE)))
    message(FATAL_ERROR "按机型收敛的固件必须编入该机型完整算法，通过运行配置启停")
endif()
foreach(field macro suffix toolchain driver driver_platform)
    string(TOUPPER "${field}" upper)
    string(JSON YS_${upper} GET "${YS_MODEL}" "${field}")
endforeach()
foreach(algo reflectivity spotslope)
    if(algo STREQUAL "reflectivity")
        set(enabled "${YS_REFLECTIVITY}")
    else()
        set(enabled "${YS_SPOT_SLOPE}")
    endif()
    if(enabled)
        string(JSON definition GET "${YS_CATALOG}" algorithms "${algo}")
        foreach(pair "models;${MODEL}" "modes;${DATA_MODE}")
            if(YS_RUNTIME_MODES AND pair MATCHES "^modes;")
                continue()
            endif()
            list(GET pair 0 key)
            list(GET pair 1 value)
            string(JSON count LENGTH "${definition}" "${key}")
            math(EXPR last "${count}-1")
            set(allowed "")
            foreach(i RANGE ${last})
                string(JSON item GET "${definition}" "${key}" ${i})
                list(APPEND allowed "${item}")
            endforeach()
            if(NOT value IN_LIST allowed)
                message(FATAL_ERROR "算法 ${algo} 不支持 ${MODEL}/${DATA_MODE}")
            endif()
        endforeach()
    endif()
endforeach()
set(YS_WORK_MODE_MASK 0)
if(YS_RUNTIME_MODES)
    set(selected_modes histogram pointcloud gray)
    set(YS_DEFAULT_WORK_MODE 2)
    foreach(mode IN LISTS selected_modes)
        string(TOUPPER "${mode}" upper)
        string(JSON YS_FORMAT_${upper} GET "${YS_MODEL}" modes "${mode}")
    endforeach()
else()
    set(selected_modes "${DATA_MODE}")
    string(JSON YS_DEFAULT_WORK_MODE GET "${YS_CATALOG}" modes "${DATA_MODE}" default_work_mode)
endif()
foreach(data_mode IN LISTS selected_modes)
    string(JSON count LENGTH "${YS_CATALOG}" modes "${data_mode}" allowed_work_modes)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
        string(JSON mode GET "${YS_CATALOG}" modes "${data_mode}" allowed_work_modes ${i})
        math(EXPR YS_WORK_MODE_MASK "${YS_WORK_MODE_MASK} | (1 << ${mode})")
    endforeach()
endforeach()
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "构建类型" FORCE)
endif()
set(YS_TOOLCHAIN_PREFIX "${YS_TOOLCHAIN}" CACHE STRING "交叉工具链前缀")
if(EXISTS "${CMAKE_SOURCE_DIR}/build/toolchains/${YS_TOOLCHAIN_PREFIX}/bin")
    set(default_toolchain "${CMAKE_SOURCE_DIR}/build/toolchains/${YS_TOOLCHAIN_PREFIX}")
else()
    set(default_toolchain "${CMAKE_SOURCE_DIR}/cc")
endif()
set(YS_TOOLCHAIN_ROOT "${default_toolchain}" CACHE PATH "独立工具链目录")
if(NOT LOCAL_TEST AND NOT CMAKE_TOOLCHAIN_FILE)
    set(CMAKE_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../aarch64-toolchain.cmake" CACHE FILEPATH "交叉工具链")
endif()
message(STATUS "构建组合：${MODEL}/${DATA_MODE}，反射率=${YS_REFLECTIVITY}，SpotSlope=${YS_SPOT_SLOPE}")
