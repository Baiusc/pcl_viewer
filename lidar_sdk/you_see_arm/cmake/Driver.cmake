if(NOT YS_RUNTIME_MODES AND EXISTS "${CMAKE_SOURCE_DIR}/build/drivers/${YS_DRIVER_PLATFORM}/src")
    set(default_driver "${CMAKE_SOURCE_DIR}/build/drivers/${YS_DRIVER_PLATFORM}")
else()
    set(default_driver "${CMAKE_SOURCE_DIR}/driver")
endif()
set(YS_DRIVER_SOURCE_DIR "${default_driver}" CACHE PATH "驱动源码目录")
target_include_directories(ys_options INTERFACE "${YS_DRIVER_SOURCE_DIR}/inc")
set(YS_PREBUILT_DRIVER "${CMAKE_SOURCE_DIR}/lib/${MODEL}/liblidar.so" CACHE FILEPATH "预编译驱动库")
if(YS_DRIVER STREQUAL "source")
    # 复制编译单元到构建目录，使引号包含的版本头也来自本次构建。
    file(GLOB driver_headers CONFIGURE_DEPENDS "${YS_DRIVER_SOURCE_DIR}/src/*.h")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/driver")
    foreach(source "${YS_DRIVER_SOURCE_DIR}/src/yousee_lidar_api.c" ${driver_headers})
        get_filename_component(name "${source}" NAME)
        if(NOT name STREQUAL "yousee_lidar_ver.h")
            configure_file("${source}" "${CMAKE_BINARY_DIR}/driver/${name}" COPYONLY)
        endif()
    endforeach()
    if(NOT EXISTS "${YS_DRIVER_SOURCE_DIR}/inc/lidar_receive_mode.h")
        message(FATAL_ERROR "${YS_DRIVER_SOURCE_DIR} 缺少统一内核对应的接收模式接口，请更新 ${YS_DRIVER_PLATFORM} 驱动源码")
    endif()
    add_custom_target(driver_version
        COMMAND sh "${YS_DRIVER_SOURCE_DIR}/src/gen_version.sh" "${CMAKE_BINARY_DIR}/driver/yousee_lidar_ver.h"
        BYPRODUCTS "${CMAKE_BINARY_DIR}/driver/yousee_lidar_ver.h"
        WORKING_DIRECTORY "${YS_DRIVER_SOURCE_DIR}" COMMENT "生成驱动版本信息")
    add_library(ys_driver SHARED "${CMAKE_BINARY_DIR}/driver/yousee_lidar_api.c")
    target_include_directories(ys_driver PRIVATE "${YS_DRIVER_SOURCE_DIR}/inc")
    set_target_properties(ys_driver PROPERTIES OUTPUT_NAME lidar)
    add_dependencies(ys_driver driver_version)
    target_link_libraries(you_see PRIVATE ys_driver)
    install(TARGETS ys_driver LIBRARY DESTINATION lib)
elseif(YS_DRIVER STREQUAL "v4l2")
    file(READ "${YS_DRIVER_SOURCE_DIR}/inc/yousee_lidar_api_public.h" driver_header)
    if(NOT driver_header MATCHES "V4l2Buffer")
        message(FATAL_ERROR "FL6031 需要 t507 驱动；请执行 python3 scripts/build.py prepare MF150-fl6031，再使用新构建目录")
    endif()
    add_library(ys_driver SHARED "${YS_DRIVER_SOURCE_DIR}/src/yousee_lidar_api.c")
    set_target_properties(ys_driver PROPERTIES OUTPUT_NAME lidar)
    target_link_libraries(you_see PRIVATE ys_driver)
    install(TARGETS ys_driver LIBRARY DESTINATION lib)
elseif(YS_DRIVER STREQUAL "prebuilt")
    if(NOT EXISTS "${YS_PREBUILT_DRIVER}")
        message(FATAL_ERROR "缺少预编译驱动 ${YS_PREBUILT_DRIVER}")
    endif()
    message(WARNING "${MODEL} 使用预编译驱动；库内模式无法由构建系统确认，发布前须板端验证 ${DATA_MODE}")
    add_library(ys_driver SHARED IMPORTED)
    set_target_properties(ys_driver PROPERTIES IMPORTED_LOCATION "${YS_PREBUILT_DRIVER}" IMPORTED_NO_SONAME TRUE)
    target_link_libraries(you_see PRIVATE ys_driver)
    install(FILES "${YS_PREBUILT_DRIVER}" DESTINATION lib RENAME liblidar.so)
endif()
