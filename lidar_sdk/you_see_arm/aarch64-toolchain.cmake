# 工具链只读使用；构建过程不再切换 cc 或 driver 的 Git 分支。
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES YS_TOOLCHAIN_ROOT YS_TOOLCHAIN_PREFIX)
if(NOT YS_TOOLCHAIN_ROOT OR NOT YS_TOOLCHAIN_PREFIX)
    message(FATAL_ERROR "请通过项目预设选择工具链，或指定 YS_TOOLCHAIN_ROOT 和 YS_TOOLCHAIN_PREFIX")
endif()
set(CMAKE_C_COMPILER "${YS_TOOLCHAIN_ROOT}/bin/${YS_TOOLCHAIN_PREFIX}-gcc")
set(CMAKE_CXX_COMPILER "${YS_TOOLCHAIN_ROOT}/bin/${YS_TOOLCHAIN_PREFIX}-g++")
foreach(compiler "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}")
    if(NOT EXISTS "${compiler}")
        message(FATAL_ERROR "缺少工具链：${compiler}。请设置 YS_TOOLCHAIN_ROOT；不会自动切换子模块。")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot OUTPUT_VARIABLE _sysroot OUTPUT_STRIP_TRAILING_WHITESPACE)
if(_sysroot)
    set(CMAKE_FIND_ROOT_PATH "${_sysroot}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
